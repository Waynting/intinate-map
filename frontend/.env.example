# Google Maps JavaScript API (Browser Key)
# ⚠️  REQUIRED: Enable Maps JavaScript API in Google Cloud Console
# ⚠️  Add HTTP referrer restrictions:
#    - http://localhost:5173/*
#    - http://127.0.0.1:5173/*
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=YOUR_BROWSER_KEY_HERE

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ⚠️  IMPORTANT: Frontend MUST run on port 5173 (assignment requirement)
# Run with: npm run dev (configured to use port 5173)

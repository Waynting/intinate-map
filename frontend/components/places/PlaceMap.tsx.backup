"use client";

import { useEffect, useRef, useState } from "react";
import { Loader } from "@googlemaps/js-api-loader";
import { MarkerClusterer } from "@googlemaps/markerclusterer";
import type { Place } from "@/lib/api";

interface PlaceMapProps {
  places: Place[];
  onMarkerClick?: (place: Place) => void;
  onMapClick?: (lat: number, lng: number) => void;
  onBoundsChange?: (bounds: { ne: { lat: number; lng: number }; sw: { lat: number; lng: number } }) => void;
  onPlaceAction?: (action: string, placeId: string) => void;
  selectedPlaceId?: string;
  focusedPlaceId?: string;
}

export function PlaceMap({ places, onMarkerClick, onMapClick, onBoundsChange, onPlaceAction, selectedPlaceId, focusedPlaceId }: PlaceMapProps) {
  const mapRef = useRef<HTMLDivElement>(null);
  const googleMapRef = useRef<google.maps.Map | null>(null);
  const markersRef = useRef<Map<string, google.maps.Marker>>(new Map());
  const clustererRef = useRef<MarkerClusterer | null>(null);
  const infoWindowRef = useRef<google.maps.InfoWindow | null>(null);
  const glowMarkersRef = useRef<Map<string, google.maps.Marker>>(new Map());
  const hoverTooltipRef = useRef<google.maps.InfoWindow | null>(null);
  const [isLoaded, setIsLoaded] = useState(false);
  const [isMobile, setIsMobile] = useState(false);

  // Debug: Log places data on mount and update (development only)
  useEffect(() => {
    if (process.env.NODE_ENV === 'development') {
      console.log('[PlaceMap] Received places:', {
        count: places.length,
        samplePlace: places[0],
        isLoaded,
      });
    }
  }, [places, isLoaded]);

  // Detect mobile device
  useEffect(() => {
    const checkMobile = () => {
      setIsMobile(window.innerWidth < 768);
    };
    checkMobile();
    window.addEventListener('resize', checkMobile);
    return () => window.removeEventListener('resize', checkMobile);
  }, []);

  // Initialize map
  useEffect(() => {
    // Prevent duplicate initialization
    if (googleMapRef.current) {
      return;
    }

    if (!mapRef.current) {
      return;
    }

    const loader = new Loader({
      apiKey: process.env.NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY || "",
      version: "weekly",
    });

    let isMounted = true;
    let mapInstance: google.maps.Map | null = null;

    // Create a dedicated container for the map that React won't touch
    const mapContainer = document.createElement('div');
    mapContainer.style.width = '100%';
    mapContainer.style.height = '100%';
    mapContainer.style.position = 'absolute';
    mapContainer.style.top = '0';
    mapContainer.style.left = '0';
    mapRef.current.appendChild(mapContainer);

    loader.load().then(() => {
      // Check if component is still mounted and map hasn't been created
      if (!isMounted || !mapContainer.parentElement || googleMapRef.current) {
        return;
      }

      // Center on Taipei (雙北市中心)
      const center = { lat: 25.0330, lng: 121.5654 };

      mapInstance = new google.maps.Map(mapContainer, {
        center,
        zoom: 11,
        // Enhanced map styling for better visual clarity
        styles: [
          {
            featureType: "poi",
            stylers: [{ visibility: "off" }],
          },
          {
            featureType: "transit",
            stylers: [{ visibility: "off" }],
          },
          {
            featureType: "road",
            elementType: "labels",
            stylers: [{ visibility: "simplified" }],
          },
          {
            featureType: "water",
            elementType: "geometry",
            stylers: [{ color: "#e0f2fe" }],
          },
          {
            featureType: "landscape",
            elementType: "geometry",
            stylers: [{ color: "#fafafa" }],
          },
        ],
        // Better map controls
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true,
        zoomControl: true,
        zoomControlOptions: {
          position: google.maps.ControlPosition.RIGHT_CENTER,
        },
      });

      googleMapRef.current = mapInstance;

      // Add click listener
      if (onMapClick) {
        mapInstance.addListener("click", (e: google.maps.MapMouseEvent) => {
          if (e.latLng) {
            onMapClick(e.latLng.lat(), e.latLng.lng());
          }
        });
      }

      // Add bounds change listener (fires when map stops moving)
      if (onBoundsChange) {
        mapInstance.addListener("idle", () => {
          const bounds = googleMapRef.current?.getBounds();
          if (bounds) {
            const ne = bounds.getNorthEast();
            const sw = bounds.getSouthWest();
            onBoundsChange({
              ne: { lat: ne.lat(), lng: ne.lng() },
              sw: { lat: sw.lat(), lng: sw.lng() },
            });
          }
        });
      }

      // Make map keyboard accessible
      if (mapContainer) {
        mapContainer.setAttribute('tabindex', '0');
        mapContainer.setAttribute('role', 'application');
        mapContainer.setAttribute('aria-label', '地圖檢視 - 使用方向鍵瀏覽地點，Enter 鍵選擇');
      }

      setIsLoaded(true);
      if (process.env.NODE_ENV === 'development') {
        console.log('[PlaceMap] Google Maps loaded successfully');
      }
    }).catch((error) => {
      if (process.env.NODE_ENV === 'development') {
        console.error('[PlaceMap] Failed to load Google Maps:', error);
      }
    });

    // Comprehensive cleanup function
    return () => {
      isMounted = false;

      // First close all InfoWindows to prevent DOM errors
      try {
        if (infoWindowRef.current) {
          google.maps.event.clearInstanceListeners(infoWindowRef.current);
          infoWindowRef.current.close();
          infoWindowRef.current = null;
        }
      } catch (e) {
        // Ignore
      }

      try {
        if (hoverTooltipRef.current) {
          google.maps.event.clearInstanceListeners(hoverTooltipRef.current);
          hoverTooltipRef.current.close();
          hoverTooltipRef.current = null;
        }
      } catch (e) {
        // Ignore
      }

      // Clean up markers safely
      try {
        markersRef.current.forEach((marker) => {
          try {
            marker.setMap(null);
          } catch (e) {
            // Ignore errors during cleanup
          }
        });
        markersRef.current.clear();
      } catch (e) {
        // Ignore cleanup errors
      }

      // Clean up glow markers
      try {
        glowMarkersRef.current.forEach((glow) => {
          try {
            glow.setMap(null);
          } catch (e) {
            // Ignore errors
          }
        });
        glowMarkersRef.current.clear();
      } catch (e) {
        // Ignore cleanup errors
      }

      // Clean up clusterer
      try {
        if (clustererRef.current) {
          clustererRef.current.clearMarkers();
          clustererRef.current = null;
        }
      } catch (e) {
        // Ignore cleanup errors
      }

      // Clear map reference
      if (googleMapRef.current) {
        try {
          google.maps.event.clearInstanceListeners(googleMapRef.current);
        } catch (e) {
          // Ignore
        }
        googleMapRef.current = null;
      }

      // Remove the map container from DOM manually
      // This prevents React from trying to clean up Google Maps' DOM
      if (mapContainer && mapContainer.parentElement) {
        try {
          mapContainer.parentElement.removeChild(mapContainer);
        } catch (e) {
          // Ignore errors
        }
      }
    };
  }, []); // Remove dependencies to prevent re-initialization

  // Helper function to create InfoWindow content
  const createInfoWindowContent = (place: Place): string => {
    const typeLabels: Record<string, string> = {
      hotel: "飯店",
      motel: "汽車旅館",
      short_stay: "民宿",
    };

    const privacyTagLabels: Record<string, string> = {
      self_checkin: "自助入住",
      soundproof: "隔音良好",
      private_parking: "私人停車",
      discreet_entrance: "隱密入口",
    };

    return `
      <div style="padding: 12px; max-width: 320px; font-family: system-ui, -apple-system, sans-serif;">
        <h3 style="margin: 0 0 8px 0; font-size: 16px; font-weight: 600; color: #1f2937;">
          ${place.name}
        </h3>
        <div style="margin-bottom: 8px;">
          <span style="
            background: ${getTypeColor(place.type)};
            color: white;
            padding: 3px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 500;
          ">
            ${typeLabels[place.type] || place.type}
          </span>
        </div>
        ${place.googleRating ? `
          <div style="margin-bottom: 6px; font-size: 14px; color: #374151;">
            ⭐ <strong>${place.googleRating.toFixed(1)}</strong>
            <span style="color: #6b7280; font-size: 12px;">
              (${place.googleRatingsTotal?.toLocaleString() || 0} 則評論)
            </span>
          </div>
        ` : ''}
        ${place.address ? `
          <div style="font-size: 13px; color: #6b7280; margin-bottom: 8px; line-height: 1.4;">
            📍 ${place.address}
          </div>
        ` : ''}
        ${place.privacyTags && place.privacyTags.length > 0 ? `
          <div style="margin-top: 8px; margin-bottom: 12px; display: flex; flex-wrap: wrap; gap: 4px;">
            ${place.privacyTags.slice(0, 4).map(tag =>
              `<span style="
                background: #f3f4f6;
                color: #374151;
                padding: 3px 8px;
                border-radius: 4px;
                font-size: 11px;
              ">
                ${privacyTagLabels[tag] || tag}
              </span>`
            ).join('')}
          </div>
        ` : ''}
        <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #e5e7eb; display: flex; gap: 8px;">
          <a
            href="/places/${place.id}"
            style="
              flex: 1;
              text-align: center;
              padding: 8px 16px;
              background: #2563eb;
              color: white;
              text-decoration: none;
              border-radius: 6px;
              font-size: 13px;
              font-weight: 500;
              cursor: pointer;
              transition: background 0.2s;
            "
            onmouseover="this.style.background='#1e40af'"
            onmouseout="this.style.background='#2563eb'"
          >
            查看詳情
          </a>
          <a
            href="https://www.google.com/maps/dir/?api=1&destination=${place.latitude},${place.longitude}"
            target="_blank"
            rel="noopener noreferrer"
            style="
              padding: 8px 12px;
              background: #f3f4f6;
              color: #374151;
              text-decoration: none;
              border-radius: 6px;
              font-size: 13px;
              font-weight: 500;
              cursor: pointer;
              transition: background 0.2s;
            "
            onmouseover="this.style.background='#e5e7eb'"
            onmouseout="this.style.background='#f3f4f6'"
            title="導航至此地點"
          >
            🗺️ 導航
          </a>
        </div>
      </div>
    `;
  };

  // Update markers when places change
  useEffect(() => {
    if (!isLoaded || !googleMapRef.current) return;

    // Clear existing clusterer
    if (clustererRef.current) {
      clustererRef.current.clearMarkers();
      clustererRef.current = null;
    }

    // Clear existing markers and glow effects
    markersRef.current.forEach((marker) => marker.setMap(null));
    markersRef.current.clear();
    glowMarkersRef.current.forEach((glow) => glow.setMap(null));
    glowMarkersRef.current.clear();

    // If no places, reset map to default view
    if (places.length === 0) {
      googleMapRef.current.setCenter({ lat: 25.0330, lng: 121.5654 });
      googleMapRef.current.setZoom(11);
      return;
    }

    // Determine marker sizes based on device
    const baseScale = isMobile ? 12 : 8;
    const selectedScale = isMobile ? 18 : 14;

    // Add new markers with coordinate validation
    let successCount = 0;
    let skipCount = 0;

    places.forEach((place, index) => {
      // Validate coordinates
      const lat = Number(place.latitude);
      const lng = Number(place.longitude);

      // Check if coordinates are valid numbers
      if (isNaN(lat) || isNaN(lng)) {
        if (process.env.NODE_ENV === 'development') {
          console.error(`[PlaceMap] Invalid coordinates for ${place.name}:`, { latitude: place.latitude, longitude: place.longitude });
        }
        skipCount++;
        return; // Skip this marker
      }

      // Check if coordinates are within valid range
      if (lat < -90 || lat > 90 || lng < -180 || lng > 180) {
        if (process.env.NODE_ENV === 'development') {
          console.error(`[PlaceMap] Coordinates out of range for ${place.name}:`, { lat, lng });
        }
        skipCount++;
        return; // Skip this marker
      }

      // Optional: Filter places outside Taiwan bounds for better performance
      const TAIWAN_BOUNDS = {
        minLat: 21.5, maxLat: 26.0,
        minLng: 118.0, maxLng: 122.5
      };

      if (lat < TAIWAN_BOUNDS.minLat || lat > TAIWAN_BOUNDS.maxLat ||
          lng < TAIWAN_BOUNDS.minLng || lng > TAIWAN_BOUNDS.maxLng) {
        if (process.env.NODE_ENV === 'development') {
          console.warn(`[PlaceMap] Place outside Taiwan bounds: ${place.name} (${lat}, ${lng})`);
        }
        // Continue anyway - don't skip, as some places might be near borders
      }

      const isSelected = place.id === selectedPlaceId;

      try {
        const marker = new google.maps.Marker({
          position: { lat, lng },
          map: googleMapRef.current!,
          title: place.name,
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            scale: isSelected ? selectedScale : baseScale,
            fillColor: isSelected ? "#2563eb" : getTypeColor(place.type),
            fillOpacity: isSelected ? 1 : 0.85,
            strokeColor: isSelected ? "#1e40af" : "#ffffff",
            strokeWeight: isSelected ? 4 : 2,
          },
          animation: isSelected ? google.maps.Animation.BOUNCE : undefined,
        });

        // Stop bounce animation after 700ms
        if (isSelected) {
          setTimeout(() => marker.setAnimation(null), 700);
        }

        // Store place ID for later reference
        marker.set('placeId', place.id);

        // Add hover listener for preview
        marker.addListener("mouseover", () => {
          // Scale up marker on hover
          const currentScale = isSelected ? selectedScale : baseScale;
          marker.setIcon({
            path: google.maps.SymbolPath.CIRCLE,
            scale: currentScale + 2,
            fillColor: isSelected ? "#2563eb" : getTypeColor(place.type),
            fillOpacity: 1,
            strokeColor: isSelected ? "#1e40af" : "#ffffff",
            strokeWeight: isSelected ? 4 : 3,
          });

          // Show preview tooltip
          if (hoverTooltipRef.current) {
            try {
              hoverTooltipRef.current.close();
            } catch (e) {
              // Ignore errors
            }
            hoverTooltipRef.current = null;
          }

          hoverTooltipRef.current = new google.maps.InfoWindow({
            content: `
              <div style="padding: 6px 10px; font-size: 13px; font-weight: 500; color: #1f2937;">
                ${place.name}
              </div>
            `,
            disableAutoPan: true,
          });

          if (googleMapRef.current) {
            hoverTooltipRef.current.open(googleMapRef.current, marker);
          }
        });

        // Add mouseout listener
        marker.addListener("mouseout", () => {
          // Reset marker size
          marker.setIcon({
            path: google.maps.SymbolPath.CIRCLE,
            scale: isSelected ? selectedScale : baseScale,
            fillColor: isSelected ? "#2563eb" : getTypeColor(place.type),
            fillOpacity: isSelected ? 1 : 0.85,
            strokeColor: isSelected ? "#1e40af" : "#ffffff",
            strokeWeight: isSelected ? 4 : 2,
          });

          // Close preview tooltip
          if (hoverTooltipRef.current) {
            try {
              hoverTooltipRef.current.close();
            } catch (e) {
              // Ignore errors
            }
            hoverTooltipRef.current = null;
          }
        });

        // Add click listener
        if (onMarkerClick) {
          marker.addListener("click", () => {
            // Safely close previous InfoWindow
            if (infoWindowRef.current) {
              try {
                google.maps.event.clearInstanceListeners(infoWindowRef.current);
                infoWindowRef.current.close();
                infoWindowRef.current = null;
              } catch (e) {
                // Ignore errors during close
                infoWindowRef.current = null;
              }
            }

            // Close hover tooltip
            if (hoverTooltipRef.current) {
              try {
                google.maps.event.clearInstanceListeners(hoverTooltipRef.current);
                hoverTooltipRef.current.close();
                hoverTooltipRef.current = null;
              } catch (e) {
                // Ignore errors
              }
            }

            // Only create InfoWindow if map still exists
            if (!googleMapRef.current) return;

            try {
              infoWindowRef.current = new google.maps.InfoWindow({
                content: createInfoWindowContent(place),
                maxWidth: 300,
              });

              // Add closeclick listener to clean up reference
              google.maps.event.addListener(infoWindowRef.current, 'closeclick', () => {
                if (infoWindowRef.current) {
                  try {
                    google.maps.event.clearInstanceListeners(infoWindowRef.current);
                  } catch (e) {
                    // Ignore
                  }
                  infoWindowRef.current = null;
                }
              });

              infoWindowRef.current.open(googleMapRef.current, marker);
            } catch (e) {
              // If InfoWindow creation fails, just continue
              console.error('Failed to create InfoWindow:', e);
            }

            // Call parent handler
            onMarkerClick(place);
          });
        }

        markersRef.current.set(place.id, marker);
        successCount++;
      } catch (error) {
        if (process.env.NODE_ENV === 'development') {
          console.error(`[PlaceMap] Failed to create marker for ${place.name}:`, error);
        }
        skipCount++;
      }
    });

    // Log summary (development only)
    if (process.env.NODE_ENV === 'development') {
      console.log(`[PlaceMap] Marker creation complete:`, {
        total: places.length,
        created: successCount,
        skipped: skipCount,
        markerMapSize: markersRef.current.size
      });
    }

    // Initialize MarkerClusterer for performance optimization
    if (markersRef.current.size > 0 && googleMapRef.current) {
      const markers = Array.from(markersRef.current.values());

      clustererRef.current = new MarkerClusterer({
        map: googleMapRef.current,
        markers: markers,
        renderer: {
          render: ({ count, position }, stats) => {
            // Custom cluster styling with color based on density
            const color =
              count > 100 ? "#dc2626" :  // Red for >100
              count > 50 ? "#ea580c" :   // Orange for >50
              count > 20 ? "#f59e0b" :   // Amber for >20
              "#10b981";                 // Green for <=20

            return new google.maps.Marker({
              position,
              icon: {
                path: google.maps.SymbolPath.CIRCLE,
                scale: Math.min(30 + Math.log(count) * 3, 50),
                fillColor: color,
                fillOpacity: 0.8,
                strokeColor: "#ffffff",
                strokeWeight: 3,
              },
              label: {
                text: String(count),
                color: "#ffffff",
                fontSize: "14px",
                fontWeight: "bold",
              },
              zIndex: Number(google.maps.Marker.MAX_ZINDEX) + count,
            });
          },
        },
      });

      if (process.env.NODE_ENV === 'development') {
        console.log(`[PlaceMap] MarkerClusterer initialized with ${markers.length} markers`);
      }
    }

    // Auto-fit bounds to show all markers with valid coordinates
    if (places.length > 0 && googleMapRef.current) {
      const bounds = new google.maps.LatLngBounds();
      let validPlaceCount = 0;

      // Define reasonable bounds for Shuangbei (Taipei + New Taipei)
      const SHUANGBEI_BOUNDS = {
        minLat: 24.6, maxLat: 25.3,
        minLng: 121.3, maxLng: 121.8
      };

      places.forEach((place) => {
        const lat = Number(place.latitude);
        const lng = Number(place.longitude);

        // Validate coordinates
        if (isNaN(lat) || isNaN(lng)) {
          return; // Skip invalid coordinates
        }

        // Only include places within reasonable Shuangbei bounds for better map view
        if (lat >= SHUANGBEI_BOUNDS.minLat && lat <= SHUANGBEI_BOUNDS.maxLat &&
            lng >= SHUANGBEI_BOUNDS.minLng && lng <= SHUANGBEI_BOUNDS.maxLng) {
          bounds.extend({ lat, lng });
          validPlaceCount++;
        }
      });

      // Only apply bounds if we have valid places
      if (validPlaceCount > 0 && !bounds.isEmpty()) {
        // Apply bounds
        googleMapRef.current.fitBounds(bounds, {
          top: 50,
          right: 50,
          bottom: 50,
          left: 50,
        });

        // Prevent excessive zoom
        const listener = google.maps.event.addListenerOnce(googleMapRef.current, "bounds_changed", () => {
          const zoom = googleMapRef.current?.getZoom();
          if (validPlaceCount === 1) {
            // For single place, use moderate zoom
            googleMapRef.current?.setZoom(15);
          } else if (zoom && zoom > 16) {
            // Prevent zooming in too close when places are clustered
            googleMapRef.current?.setZoom(16);
          } else if (zoom && zoom < 10) {
            // Ensure minimum zoom level
            googleMapRef.current?.setZoom(10);
          }
        });
      } else {
        // No valid places in Shuangbei bounds, show default view
        if (process.env.NODE_ENV === 'development') {
          console.warn('[PlaceMap] No valid places in Shuangbei bounds, showing default view');
        }
        googleMapRef.current.setCenter({ lat: 25.0330, lng: 121.5654 });
        googleMapRef.current.setZoom(11);
      }
    }
  }, [places, isLoaded, onMarkerClick, isMobile]);

  // Update selected marker with enhanced visual feedback
  useEffect(() => {
    if (!isLoaded || !googleMapRef.current) return;

    const baseScale = isMobile ? 12 : 8;
    const selectedScale = isMobile ? 18 : 14;

    // Clear all glow markers
    glowMarkersRef.current.forEach((glow) => glow.setMap(null));
    glowMarkersRef.current.clear();

    markersRef.current.forEach((marker, id) => {
      const place = places.find((p) => p.id === id);
      const isSelected = id === selectedPlaceId;

      if (place) {
        // Update marker icon
        marker.setIcon({
          path: google.maps.SymbolPath.CIRCLE,
          scale: isSelected ? selectedScale : baseScale,
          fillColor: isSelected ? "#2563eb" : getTypeColor(place.type),
          fillOpacity: isSelected ? 1 : 0.85,
          strokeColor: isSelected ? "#1e40af" : "#ffffff",
          strokeWeight: isSelected ? 4 : 2,
        });

        // Add bounce animation for newly selected marker
        if (isSelected) {
          marker.setAnimation(google.maps.Animation.BOUNCE);
          setTimeout(() => marker.setAnimation(null), 700);

          // Add glow effect
          const glowMarker = new google.maps.Marker({
            position: marker.getPosition()!,
            map: googleMapRef.current!,
            icon: {
              path: google.maps.SymbolPath.CIRCLE,
              scale: isMobile ? 26 : 22,
              fillColor: "#2563eb",
              fillOpacity: 0.2,
              strokeColor: "#2563eb",
              strokeWeight: 2,
              strokeOpacity: 0.4,
            },
            zIndex: -1,
          });

          glowMarkersRef.current.set(id, glowMarker);
        }
      }
    });

    // Smart pan: only if marker is off-screen or close to edge
    if (selectedPlaceId && googleMapRef.current) {
      const place = places.find((p) => p.id === selectedPlaceId);
      if (place) {
        const lat = Number(place.latitude);
        const lng = Number(place.longitude);

        // Validate coordinates
        if (!isNaN(lat) && !isNaN(lng)) {
          const position = new google.maps.LatLng(lat, lng);
          const bounds = googleMapRef.current.getBounds();

          if (bounds) {
            const isVisible = bounds.contains(position);

            if (!isVisible) {
              // Marker is off-screen, pan to it smoothly
              googleMapRef.current.panTo(position);
            }
            // If marker is visible, keep current view - user might want to explore nearby places
            // Don't force zoom - respect user's current zoom level
          }
        } else {
          if (process.env.NODE_ENV === 'development') {
            console.error(`[PlaceMap] Invalid coordinates for selected place ${place.name}`);
          }
        }
      }
    }
  }, [selectedPlaceId, isLoaded, places, isMobile]);

  // Keyboard navigation for accessibility
  useEffect(() => {
    if (!isLoaded || !googleMapRef.current || !mapRef.current) return;

    const mapDiv = mapRef.current;
    let currentMarkerIndex = 0;

    const handleKeyDown = (e: KeyboardEvent) => {
      const markerArray = Array.from(markersRef.current.entries());
      if (markerArray.length === 0) return;

      // Find current selected index
      if (selectedPlaceId) {
        const foundIndex = markerArray.findIndex(([id]) => id === selectedPlaceId);
        if (foundIndex !== -1) {
          currentMarkerIndex = foundIndex;
        }
      }

      switch (e.key) {
        case 'Tab':
        case 'ArrowRight':
        case 'ArrowDown':
          e.preventDefault();
          currentMarkerIndex = (currentMarkerIndex + 1) % markerArray.length;
          selectMarkerByIndex(markerArray, currentMarkerIndex);
          break;

        case 'ArrowLeft':
        case 'ArrowUp':
          e.preventDefault();
          currentMarkerIndex = (currentMarkerIndex - 1 + markerArray.length) % markerArray.length;
          selectMarkerByIndex(markerArray, currentMarkerIndex);
          break;

        case 'Enter':
        case ' ':
          e.preventDefault();
          const [placeId] = markerArray[currentMarkerIndex];
          const place = places.find(p => p.id === placeId);
          if (place && onMarkerClick) {
            onMarkerClick(place);

            // Announce to screen readers
            announceToScreenReader(`已選擇 ${place.name}`);
          }
          break;

        case 'Escape':
          e.preventDefault();
          // Close InfoWindow
          if (infoWindowRef.current) {
            try {
              infoWindowRef.current.close();
            } catch (e) {
              // Ignore errors
            }
            infoWindowRef.current = null;
          }
          break;
      }
    };

    const selectMarkerByIndex = (markerArray: Array<[string, google.maps.Marker]>, index: number) => {
      const [placeId] = markerArray[index];
      const place = places.find(p => p.id === placeId);
      if (place && onMarkerClick) {
        onMarkerClick(place);

        // Announce to screen readers
        const typeLabels: Record<string, string> = {
          hotel: "飯店",
          motel: "汽車旅館",
          short_stay: "民宿",
        };

        const rating = place.googleRating ? `評分 ${place.googleRating.toFixed(1)} 分` : '尚無評分';
        announceToScreenReader(
          `第 ${index + 1} 個，共 ${markerArray.length} 個地點。${place.name}，${typeLabels[place.type] || place.type}，${rating}`
        );
      }
    };

    const announceToScreenReader = (message: string) => {
      const announcement = document.createElement('div');
      announcement.setAttribute('role', 'status');
      announcement.setAttribute('aria-live', 'polite');
      announcement.setAttribute('aria-atomic', 'true');
      announcement.className = 'sr-only';
      announcement.textContent = message;
      document.body.appendChild(announcement);
      setTimeout(() => announcement.remove(), 1000);
    };

    mapDiv.addEventListener('keydown', handleKeyDown);
    return () => mapDiv.removeEventListener('keydown', handleKeyDown);
  }, [places, onMarkerClick, isLoaded, selectedPlaceId]);

  // Focus on place when focusedPlaceId changes (only pan if not visible)
  useEffect(() => {
    if (!focusedPlaceId || !googleMapRef.current || !isLoaded) return;

    const place = places.find(p => p.id === focusedPlaceId);
    if (!place) return;

    const lat = Number(place.latitude);
    const lng = Number(place.longitude);

    // Validate coordinates
    if (isNaN(lat) || isNaN(lng)) {
      if (process.env.NODE_ENV === 'development') {
        console.error(`[PlaceMap] Invalid coordinates for focused place ${place.name}`);
      }
      return;
    }

    if (process.env.NODE_ENV === 'development') {
      console.log(`[PlaceMap] Focusing on ${place.name} at (${lat}, ${lng})`);
    }

    const position = new google.maps.LatLng(lat, lng);
    const bounds = googleMapRef.current.getBounds();

    if (bounds) {
      const isVisible = bounds.contains(position);

      if (!isVisible) {
        // Only pan if marker is not visible in current view
        googleMapRef.current.panTo(position);
      }
      // If marker is visible, keep current view - user might want to explore nearby places
    }

  }, [focusedPlaceId, places, isLoaded]);


  return (
    <>
      <div ref={mapRef} className="w-full h-full relative">
        {/* Loading Indicator */}
        {!isLoaded && (
          <div className="absolute inset-0 flex items-center justify-center bg-gray-100 z-50">
            <div className="text-center">
              <div className="relative w-16 h-16 mx-auto mb-4">
                <div className="absolute inset-0 border-4 border-primary/20 rounded-full"></div>
                <div className="absolute inset-0 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
              </div>
              <p className="text-sm font-medium text-gray-700">正在載入地圖...</p>
              <p className="text-xs text-gray-500 mt-2">首次載入可能需要幾秒鐘</p>
              <div className="mt-4 flex items-center justify-center gap-2">
                <div className="w-2 h-2 bg-primary rounded-full animate-bounce" style={{ animationDelay: '0ms' }}></div>
                <div className="w-2 h-2 bg-primary rounded-full animate-bounce" style={{ animationDelay: '150ms' }}></div>
                <div className="w-2 h-2 bg-primary rounded-full animate-bounce" style={{ animationDelay: '300ms' }}></div>
              </div>
            </div>
          </div>
        )}
      </div>
      <style jsx global>{`
        .sr-only {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border-width: 0;
        }
      `}</style>
    </>
  );
}

function getTypeColor(type: string): string {
  const colors: Record<string, string> = {
    hotel: "#059669", // Darker green for better contrast
    motel: "#db2777", // Darker pink for better contrast
    short_stay: "#f97316", // Orange for better distinction
  };
  return colors[type] || "#6b7280";
}

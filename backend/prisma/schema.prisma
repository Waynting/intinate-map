// Prisma Schema for Intimate Spaces Taipei
// Database: SQLite (local development) / PostgreSQL (production)
// Date: 2025-10-18
// Note: Read-only display application (no user authentication)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// User Model - Keep for legacy data (createdBy references)
// ============================================================================
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  places Place[]

  @@map("users")
}

// ============================================================================
// Place Model - Hotels/Motels/Short-stay spaces
// ============================================================================
model Place {
  id        String   @id @default(uuid())
  name      String
  type      String   // hotel | motel | short_stay
  address   String?
  latitude  Float
  longitude Float

  // Google Places Integration (legacy data, kept for existing records)
  googlePlaceId      String? @map("google_place_id")
  googleRating       Float?  @map("google_rating")
  googleRatingsTotal Int?    @map("google_ratings_total")
  googlePriceLevel   Int?    @map("google_price_level") // 0-4

  // Privacy & Amenities (JSON array)
  // ["self_checkin", "soundproof", "garage", "cash_only", "kiosk", "hourly_rate"]
  privacyTags String? @map("privacy_tags")

  // Metadata
  source    String   @default("import") // taipei-open-data | import | system
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  // Indexes for performance
  @@index([latitude, longitude], name: "idx_places_latlng")
  @@index([type], name: "idx_places_type")
  @@index([googleRating], name: "idx_places_rating")
  @@map("places")
}

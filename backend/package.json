{
  "name": "intimate-spaces-taipei-backend",
  "version": "1.0.0",
  "description": "Backend API for Intimate Spaces Taipei - Private accommodation discovery platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio",
    "import:hotels": "tsx src/scripts/import-hotels.ts",
    "import:hotels:dry": "tsx src/scripts/import-hotels.ts --dry-run"
  },
  "keywords": ["express", "typescript", "prisma", "sqlite"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.9",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

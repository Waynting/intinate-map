# Server Configuration
PORT=3000
NODE_ENV=development

# CORS - Frontend URLs (Required: port 5173 for assignment specs)
# ⚠️  IMPORTANT: Frontend MUST run on port 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database - SQLite (file path)
# For production, change to PostgreSQL or MySQL
DATABASE_URL="file:./dev.db"

# Authentication - JWT Configuration
JWT_SECRET=replace_with_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d

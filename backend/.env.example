# Server Configuration
PORT=3000
NODE_ENV=development

# CORS - Frontend URLs (Required: port 5173 for assignment specs)
# ⚠️  IMPORTANT: Frontend MUST run on port 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database - SQLite (file path)
DATABASE_URL="file:./dev.db"

# Authentication - JWT Configuration
JWT_SECRET=replace_with_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Google Maps API - Server Key
# ⚠️  REQUIRED: Enable ALL three APIs in Google Cloud Console:
#    1. Geocoding API
#    2. Places API
#    3. Directions API
#
# ⚠️  SECURITY WARNING:
#    - For local development: No IP restrictions needed
#    - For production: MUST add IP restrictions to prevent unauthorized use
#    - This key will be shared for peer review, keep it unrestricted for now
GOOGLE_MAPS_SERVER_KEY=YOUR_SERVER_KEY_HERE
